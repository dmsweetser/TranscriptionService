# Assembly AI API key (required for real transcription)
# Get one at: https://assemblyai.com
ASSEMBLY_AI_API_KEY=your_assembly_ai_key_here

# Admin password (plain text - will be converted to hash)
# After running install.sh or setup_admin.py, this line is replaced with ADMIN_PASSWORD_HASH
ADMIN_PASSWORD=your_strong_password_here

# Ports
TRANSCRIPTION_PORT=5123
TRANSLATION_PORT=5001

# Audio input device name (leave as-is for default, or specify e.g. "Built-in Microphone")
DEFAULT_AUDIO_DEVICE=Default Audio Device

# Words to boost transcription accuracy (comma-separated)
BIAS_WORDS=transcription,translation

# Where to save transcription text files
SAVE_LOCATION=./transcriptions

# Flask session secret key (auto-generated if missing)
SECRET_KEY=change_me_to_a_secure_random_string

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5123,http://localhost:5001

# Gunicorn workers (must be 1 - single-process required)
GUNICORN_WORKERS=1
